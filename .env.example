# Copiar como .env y completar con los valores que muestra `npm run db:start`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Solo para los tests (Vitest crea y borra usuarios). Es la "secret key" de `npm run db:start`.
# Nunca le pongas el prefijo VITE_: no debe llegar al frontend.
SUPABASE_SERVICE_ROLE_KEY=
